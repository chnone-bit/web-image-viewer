# ============================================================
# 论坛图片浏览器 · .gitignore
# ============================================================

# —— AI 助手的工作记忆（个人上下文，不入库） ——
.workbuddy/memory/
# 但保留测试套件：测试是代码资产，必须随版本走
!.workbuddy/test/

# —— 临时 / 调试脚本 ——
# 开发期的临时验证脚本（如 tmp-*.js），确认无价值后应清理
tmp-*.js
*.tmp

# —— 本地环境 ——
.DS_Store
Thumbs.db
desktop.ini

# —— 日志 / 缓存 ——
*.log
npm-debug.log*
.cache/

# —— 依赖（本项目是单文件油猴脚本，实际用不到；防止误提交） ——
node_modules/
# 测试依赖的包描述文件（jsdom 等由 npm i 本地生成，不入库）
package.json
package-lock.json

# —— 编辑器 ——
.vscode/
.idea/
*.swp
*~
